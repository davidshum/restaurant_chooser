# Copy to .env and fill in. With no keys at all the app runs in demo mode.

# Yelp Fusion API — https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# Google Places API (New) — enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=

# Optional: BestTime.app private key for LIVE busyness-based wait times
BESTTIME_API_KEY_PRIVATE=

# PORT=3000
# DEMO=1   # force demo data even if keys are set
